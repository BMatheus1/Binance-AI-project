{
  "protocol_version": "phase6.4-v1-supervised-demo",
  "inherits": "configs/phase_6_2.json",
  "environment": "DEMO",
  "default_mode": "OBSERVE",
  "real_trading_supported": false,
  "automatic_promotion": false,
  "endpoints": {
    "rest": "https://demo-api.binance.com/api",
    "rest_root": "https://demo-api.binance.com",
    "websocket_api": "wss://demo-ws-api.binance.com/ws-api/v3",
    "market_stream": "wss://demo-stream.binance.com"
  },
  "observation": {
    "required_seconds": 86400,
    "sample_seconds": 30,
    "maximum_expected_sample_gap_seconds": 90,
    "symbols": ["BTCUSDT", "ETHUSDT", "SOLUSDT"],
    "policies": ["A_quantitative", "B_conservative_news", "C_qwen3_structured_news", "D_event_market_reaction"]
  },
  "economic_validation": {
