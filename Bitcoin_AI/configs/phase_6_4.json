  "experimental_demo": {
    "category": "EXPERIMENTAL_DEMO",
    "symbol": "BTCUSDT",
    "policy": "A_quantitative",
    "horizon_minutes": 5,
    "minimum_up_probability": 0.60,
    "quote_amount": 10.0,
    "maximum_open_positions": 1,
    "maximum_entries_per_session": 5,
    "maximum_entries_per_day": 10,
    "maximum_daily_loss_quote": 5.0,
    "maximum_total_exposure_quote": 10.0,
    "maximum_spread_bps": 10.0,
    "maximum_slippage_bps": 5.0,
    "minimum_depth_quote": 10000.0,
    "maximum_signal_age_seconds": 120,
    "cooldown_minutes": 5,
    "planned_holding_minutes": 5,
    "maximum_holding_minutes": 20,
    "maximum_extension_minutes": 3,
    "maximum_absolute_minutes": 23,
    "stop_loss_bps": 50.0,
    "session_maximum_minutes": 120,
    "authorization_confirmation": "I_AUTHORIZE_10_USDT_BINANCE_DEMO_EXPERIMENTAL",
    "orders_enabled_by_default": false
  }
