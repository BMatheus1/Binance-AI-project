{
  "protocol_version": "phase6.1-v2-qwen3-commercial-review",
  "inherits": "configs/phase_6.json",
  "universe": ["BTCUSDT", "ETHUSDT", "SOLUSDT"],
  "news_cycle_seconds": 120,
  "default_mode": "observation",
  "real_trading_supported": false,
  "demo_orders_enabled": false,
  "additional_sources": [
    {
      "id": "bitcoin_core_releases",
      "url": "https://github.com/bitcoin/bitcoin/releases.atom",
      "reliability": "project_official",
      "minimum_interval_seconds": 120,
      "content_policy": "GitHub release title, link and supplied summary only"
    },
    {
      "id": "ethereum_geth_releases",
      "url": "https://github.com/ethereum/go-ethereum/releases.atom",
      "reliability": "project_official",
      "minimum_interval_seconds": 120,
      "content_policy": "GitHub release title, link and supplied summary only"
    },
    {
      "id": "solana_agave_releases",
      "url": "https://github.com/anza-xyz/agave/releases.atom",
      "reliability": "project_official",
      "minimum_interval_seconds": 120,
      "content_policy": "GitHub release title, link and supplied summary only"
    }
  ],
  "nlp": {
    "interface_version": "financial-news-interpretation-v2",
    "primary_model_id": "Qwen/Qwen3-0.6B",
    "revision": "c1899de289a04d12100db370d81485cdf75e47ca",
    "weights_license": "Apache-2.0",
    "usage_scope": "local_commercial_compatible",
    "commercial_use_allowed": true,
    "redistribute_weights": false,
    "fine_tuning_enabled": false,
    "trust_remote_code": false,
    "enable_thinking": false,
    "maximum_input_characters": 6000,
    "maximum_input_tokens": 1024,
    "maximum_new_tokens": 360,
    "preferred_device": "auto",
    "memory_limit_bytes": 6000000000,
    "timeout_seconds": 120,
    "queue_size": 64,
    "cache_entries": 2048,
    "experimental_finbert": {
      "enabled": false,
      "model_id": "ProsusAI/finbert",
      "revision": "0bc2ac10dda6929bcb1f77ccc43c7ec5c424f031",
      "weights_license": "CC-BY-NC-SA-4.0",
      "commercial_use_allowed": false,
      "redistribute_weights": false
    },
    "optional_cardiff_baseline": {
      "enabled": false,
      "model_id": "cardiffnlp/twitter-roberta-base-sentiment-latest",
      "revision": "3216a57f2a0d9c45a2e6c20157c20c49fb4bf9c7",
      "weights_license": "CC-BY-4.0",
      "commercial_use_allowed": true,
      "attribution_required": true,
      "domain_limitation": "trained_on_tweets_not_financial_news"
    }
  },
  "policies": [
    "A_quantitative",
    "B_conservative_news",
    "C_qwen3_structured_news",
    "D_event_market_reaction"
  ],
  "policy_c": {
    "directional_adjustment_enabled": false,
    "minimum_negative_confidence": 0.85,
    "minimum_event_intensity": 0.70,
    "positive_sentiment_never_creates_trade": true,
    "invalid_or_insufficient_result_forces_abstention": true
  },
  "policy_d": {
    "directional_adjustment_enabled": false,
    "minimum_volume_ratio": 1.5,
    "minimum_post_receive_return_bps": 2.0,
    "maximum_confirmation_spread_bps": 10.0,
    "priced_in_events_cannot_confirm_entry": true
  },
  "evaluation": {
    "same_instants": true,
    "primary_metric": "paired_net_return_difference_after_costs",
    "minimum_prospective_days": 30,
    "minimum_resolved_trades_per_policy": 200,
    "multiple_testing_correction": "holm",
    "automatic_promotion": false
  },
  "operations": {
    "planned_minutes_min": 1,
    "planned_minutes_max": 20,
    "extension_minutes_max": 3,
    "absolute_minutes_max": 23,
    "record_original_close_counterfactual": true
  }
}
